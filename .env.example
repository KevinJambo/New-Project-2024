# OneDrive Audit Tool Configuration

# Microsoft Graph API Client ID
# Get this from Azure App Registration
# See setup_guide.md for instructions
ONEDRIVE_CLIENT_ID=your_client_id_here

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Enable verbose output
VERBOSE=false

# Optional: Custom token cache location
# By default, tokens are stored in system cache
# TOKEN_CACHE_PATH=/path/to/cache
